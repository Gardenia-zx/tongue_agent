APP_NAME=tongue-agent
APP_ENV=local
LOG_LEVEL=INFO

REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200

# 
LANGGRAPH_POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/tongue_agent?sslmode=disable
LANGGRAPH_STRICT_MSGPACK=true

# 
MODEL_GATEWAY_BASE_URL=https://api.deepseek.com
MODEL_GATEWAY_API_KEY=sk-b53f7218c85642b5a5deab2f642f60f0
CHAT_MODEL_NAME=deepseek-v4-pro
CHAT_MODEL_TEMPERATURE=0.2
CHAT_MODEL_MAX_TOKENS=800
CHAT_MODEL_MAX_CONCURRENCY=4

# 
AGENT_LOCK_TTL_SECONDS=120
IDEMPOTENCY_TTL_SECONDS=86400

# 意图识别
INTENT_TOP_K=5
INTENT_ROUTE_THRESHOLD=0.75
INTENT_CLARIFY_THRESHOLD=0.55

# rag召回
RAG_BM25_TOP_K=20
RAG_VECTOR_TOP_K=20
RAG_FINAL_TOP_K=8

MEMORY_ENABLED=true
LONG_TERM_MEMORY_ENABLED=true

INTENT_INDEX_NAME=intent_example_v1

EMBEDDING_MODEL_NAME=shibing624/text2vec-base-chinese
EMBEDDING_DIM=768
EMBEDDING_MAX_CONCURRENCY=2
